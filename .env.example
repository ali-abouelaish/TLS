# Template only: put the real values in .env next to this file (never served, never
# put real values here). Environment variables with the same names override .env.
#   node scripts/fetch-listings.mjs   reads the Harbor Ops API settings
#   node server.mjs                   reads the sign-in settings
#
# Base URL: your agency's Harbor Ops address.
# Key: Harbor Ops > Settings > API Keys (starts with hopk_, shown once).
HARBOR_OPS_BASE_URL=https://trustedlet.harborops.co.uk
HARBOR_OPS_API_KEY=

# Staff sign-in from Harbor Ops (node server.mjs). Leave these EMPTY here: put the values
# in a .env file next to this one on the server, or in the server's environment.
# Secret: from Harbor Ops when you tick "Sign my team in to this website" (starts with hos_).
# Audience: this site's origin, e.g. https://www.trustedlet.co.uk (no path, no trailing slash).
# Session secret: 32+ random characters, e.g. the output of
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
HARBOR_SIGN_IN_SECRET=
HARBOR_SIGN_IN_AUDIENCE=
SESSION_SECRET=
